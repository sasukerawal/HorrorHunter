# Copy to .env (local dev) or set these in Vercel → Project → Settings →
# Environment Variables (production). All are optional but TURN is strongly
# recommended — without it, voice falls back to the socket.io audio relay for
# players behind strict NATs.

# Deployed Socket.IO backend URL (Render). Leave empty for local dev (Vite proxies).
VITE_BACKEND_URL=

# ── TURN server for WebRTC voice across strict NATs ──
# Easiest (5 minutes, free 50 GB/mo):
#   1. Sign up at https://www.metered.ca/stun-turn
#   2. Create an app → copy your API key
#   3. Paste the credentials URL below:
# VITE_TURN_CREDENTIALS_URL=https://<your-app>.metered.live/api/v1/turn/credentials?apiKey=<your-key>
VITE_TURN_CREDENTIALS_URL=

# Or a static TURN server (e.g. self-hosted coturn / Twilio NTS):
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
